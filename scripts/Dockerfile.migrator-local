FROM golang:1.25.6-alpine

RUN go install github.com/rubenv/sql-migrate/...@latest
RUN apk add --no-cache gettext

WORKDIR /migrations
COPY . .

# The repository's Dockerfile.migrate uses a RUN here-document that produces an
# empty /entrypoint.sh with Docker 29.1.3 ("exec format error"). Keep the same
# content, but write it explicitly.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'envsubst < dbconfig.yml > dbconfig.yml.tmp && mv dbconfig.yml.tmp dbconfig.yml' \
    '' \
    'for f in migrations/*.sql; do' \
    '    if [ -f "$f" ]; then' \
    '        envsubst < "$f" > "$f.tmp" && mv "$f.tmp" "$f"' \
    '    fi' \
    'done' \
    '' \
    'sql-migrate up -env=chat-bot-db' \
    > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
